# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/KSR/.utmp/
/KSR/[Ll]ibrary/
/KSR/[Tt]emp/
/KSR/[Oo]bj/
/KSR/[Bb]uild/
/KSR/[Bb]uilds/
/KSR/[Ll]ogs/
/KSR/[Uu]ser[Ss]ettings/
/KSR/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/KSR/*.blend1
/KSR/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/KSR/[Mm]emoryCaptures/

# Recordings can get excessive in size
/KSR/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /KSR/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/KSR/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/KSR/*.DotSettings.user

# Visual Studio cache directory
/KSR/.vs/

# Gradle cache directory
/KSR/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/KSR/ExportedObj/
/KSR/.consulo/
/KSR/*.csproj
/KSR/*.unityproj
/KSR/*.sln
/KSR/*.suo
/KSR/*.tmp
/KSR/*.user
/KSR/*.userprefs
/KSR/*.pidb
/KSR/*.booproj
/KSR/*.svd
/KSR/*.pdb
/KSR/*.mdb
/KSR/*.opendb
/KSR/*.VC.db

# Unity3D generated meta files
/KSR/*.pidb.meta
/KSR/*.pdb.meta
/KSR/*.mdb.meta

# Unity3D generated file on crash reports
/KSR/sysinfo.txt

# Mono auto generated files
/KSR/mono_crash.*

# Builds
/KSR/*.apk
/KSR/*.aab
/KSR/*.unitypackage
/KSR/*.unitypackage.meta
/KSR/*.app

# Crashlytics generated file
/KSR/crashlytics-build.properties

# TestRunner generated files
/KSR/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/KSR/ServerData
/KSR/[Aa]ssets/StreamingAssets/aa*
/KSR/[Aa]ssets/AddressableAssetsData/link.xml*
/KSR/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /KSR/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/KSR/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/KSR/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/KSR/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/KSR/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/KSR/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/KSR/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
